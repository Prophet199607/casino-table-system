{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "casino-table-system",
  "version": "0.1.0",
  "identifier": "com.onimta.casino-table-system",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "casino-table-system",
        "width": 1024,
        "height": 768,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "connection.txt"
    ]
  }
}